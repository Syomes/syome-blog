---
import "../custom/theme.css";
interface Props {
  categories: { name: string; count: number }[];
  selectedCategory: string;
}

const { categories, selectedCategory } = Astro.props;
---

<div class="card-container rounded-2xl p-6 mb-6">
  <h2 class="text-main text-xl font-semibold mb-4">Categories</h2>
  <ul class="space-y-2">
    <li>
      <button
        class={`w-full text-left px-3 py-2 rounded-lg transition-colors ${
          selectedCategory === ""
            ? "toggle-active"
            : "toggle-inactive"
        }`}
        data-category=""
      >
        All Posts
        <span class="float-right"
          >({categories.reduce((sum, cat) => sum + cat.count, 0)})</span
        >
      </button>
    </li>
    {
      categories.map((category) => (
        <li>
          <button
            class={`w-full text-left px-3 py-2 rounded-lg transition-colors ${
              selectedCategory === category.name
                ? "toggle-active"
                : "toggle-inactive"
            }`}
            data-category={category.name}
          >
            {category.name}
            <span class="float-right">({category.count})</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>
