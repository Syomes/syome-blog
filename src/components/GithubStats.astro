---
---

<div class="mt-8 mb-8">
  <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">GitHub Statistics</h3>
  <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow">
    <div id="github-stats-container">
      <div id="github-stats-loading" class="flex justify-center items-center py-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 dark:border-indigo-400"></div>
        <span class="ml-3 text-gray-600 dark:text-gray-300">Loading GitHub stats...</span>
      </div>
      
      <div id="github-stats-content" class="hidden">
      </div>
      
      <div id="last-updated" class="text-right text-xs text-gray-500 dark:text-gray-400 mt-2">
        <span id="last-updated-time"></span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #personal-summary {
    @apply bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 
           transition-colors duration-300 ease-in-out;
  }
  #personal-summary:hover:not(:has(#personal-public-toggle:hover, #personal-private-toggle:hover)) {
    @apply bg-blue-200 dark:bg-blue-800;
  }
  #personal-summary.active-filter {
    @apply bg-blue-600 text-white dark:bg-blue-800;
  }
  #personal-summary.active-filter:hover:not(:has(#personal-public-toggle:hover, #personal-private-toggle:hover)) {
    @apply bg-blue-700 dark:bg-blue-900;
  }

  #personal-public-toggle,
  #personal-private-toggle {
    @apply bg-blue-50 text-blue-700 dark:bg-blue-800 dark:text-blue-100 
           transition-colors duration-300 ease-in-out;
  }
  #personal-public-toggle:hover,
  #personal-private-toggle:hover {
    @apply bg-blue-100 dark:bg-blue-700;
  }
  #personal-public-toggle.active-filter,
  #personal-private-toggle.active-filter {
    @apply bg-blue-400 text-white dark:bg-blue-600;
  }
  #personal-public-toggle.active-filter:hover,
  #personal-private-toggle.active-filter:hover {
    @apply bg-blue-500 dark:bg-blue-700;
  }

  #collaborator-summary {
    @apply bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 
           transition-colors duration-300 ease-in-out;
  }
  #collaborator-summary:hover:not(:has(#collaborator-public-toggle:hover, #collaborator-private-toggle:hover)) {
    @apply bg-green-200 dark:bg-green-800;
  }
  #collaborator-summary.active-filter {
    @apply bg-emerald-600 text-white dark:bg-emerald-800;
  }
  #collaborator-summary.active-filter:hover:not(:has(#collaborator-public-toggle:hover, #collaborator-private-toggle:hover)) {
    @apply bg-emerald-700 dark:bg-emerald-900;
  }

  #collaborator-public-toggle,
  #collaborator-private-toggle {
    @apply bg-green-50 text-green-700 dark:bg-green-800 dark:text-green-100 
           transition-colors duration-300 ease-in-out;
  }
  #collaborator-public-toggle:hover,
  #collaborator-private-toggle:hover {
    @apply bg-green-100 dark:bg-green-700;
  }
  #collaborator-public-toggle.active-filter,
  #collaborator-private-toggle.active-filter {
    @apply bg-emerald-400 text-white dark:bg-emerald-600;
  }
  #collaborator-public-toggle.active-filter:hover,
  #collaborator-private-toggle.active-filter:hover {
    @apply bg-emerald-500 dark:bg-emerald-700;
  }
</style>

<script>
  import { initializeGitHubStats } from "../utils/github-stats";

  if (typeof window !== 'undefined') {
    initializeGitHubStats();
  }
</script>