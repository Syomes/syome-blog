---
import "../custom/theme.css";
---

<div class="mt-16 mb-16">
  <h3 class="text-main text-xl font-semibold mb-4">GitHub Statistics</h3>
  <div class="card-container p-4 rounded-lg">
    <div id="github-stats-container">
      <div
        id="github-stats-loading"
        class="flex justify-center items-center py-8"
      >
        <div
          id="github-stats-loading-icon"
          class="animate-spin rounded-full h-8 w-8 border-b-2"
        >
        </div>
        <span class="text-tips ml-3">Loading GitHub stats...</span>
      </div>

      <div id="github-stats-content" class="hidden"></div>

      <div id="last-updated" class="text-tips text-right text-xs mt-2">
        <span id="last-updated-time"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { initializeGitHubStats } from "../utils/github-stats";

  if (typeof window !== "undefined") {
    initializeGitHubStats();
  }
</script>
