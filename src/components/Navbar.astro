---
import siteConfig from "../custom/site-config";
import blogImg from "../assets/page/blog.png";
import "../custom/theme.css";

interface Props {
  siteName?: string;
  avatarImage?: string;
  avatarAlt?: string;
  menuItems?: Array<{ name: string; link: string; iconPath: string }>;
}

const {
  siteName = siteConfig.siteName,
  avatarImage = blogImg,
  avatarAlt = "Avatar",
  menuItems = [
    {
      name: "Posts",
      link: "/posts",
      iconPath:
        "M19 22H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2z M7 7h10M7 11h10M7 15h7",
    }
  ],
} = Astro.props;
---

<nav class="navbar-container border-b sticky top-0 z-10">
  <div class="max-w-3xl mx-auto px-4 py-3">
    <div class="relative flex justify-between items-center">
      <a href="/" class="navbar-home text-xl font-bold">
        {siteName}
      </a>

      {
        avatarImage && (
          <div class="absolute left-1/2 -translate-x-1/2">
            <div class="w-16 h-16 rounded-full shadow-lg overflow-hidden soft-border">
              <img
                src={
                  typeof avatarImage === "string"
                    ? avatarImage
                    : avatarImage.src
                }
                alt={avatarAlt}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        )
      }

      <ul
        class="flex flex-wrap gap-x-6 gap-y-2 text-sm max-w-[calc(50%-2rem)] justify-end"
      >
        {
          menuItems.map((item) => (
            <li>
              <a
                href={item.link}
                class="navbar-items flex items-center space-x-1 font-medium"
              >
                <svg
                  class="w-6 h-6 pr-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="-3 -3 28 28"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={item.iconPath}
                  />
                </svg>
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<style scoped>
  .soft-border {
    position: relative;
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  .dark .soft-border {
    background: rgba(17, 24, 39, 0.8);
    border: 2px solid rgba(17, 24, 39, 0.9);
  }
</style>
