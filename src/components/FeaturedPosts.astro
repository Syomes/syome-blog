---
import "../custom/theme.css";
import { getCollection } from "astro:content";
import type { Post } from "../content/config";

const posts = await getCollection("posts");
const byDate = (a: {data: Post}, b: {data: Post}) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const pinnedPosts = posts.filter((post) => post.data.pin).sort(byDate);
if (pinnedPosts.length > 2) {
  console.warn(
    "\x1b[33m%s\x1b[0m",
    `[WARNING]: ${pinnedPosts.length} posts are pinned. Only the first two will be featured.`,
  );
  console.warn(
    "\x1b[33m%s\x1b[0m",
    `Pinned posts: ${pinnedPosts.map((p) => p.data.title).join(", ")}`,
  );
}
const restPosts = posts.filter((post) => !post.data.pin).sort(byDate);
const featuredPosts = [...pinnedPosts, ...restPosts].slice(0, 2);
---

<section class="mt-16 mb-16">
  <h2 class="text-main text-2xl font-bold mb-6">Recommended Reading</h2>

  {
    featuredPosts.length === 0 ? (
      <div class="border-container text-tips border rounded-lg p-6 text-center">
        <h3 class="text-main text-xl font-semibold mb-2">No content yet</h3>
        <p class="text-tips">
          Check back later for recommended posts.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredPosts.map((post) => (
          <article class="border-container border rounded-lg p-6 flex flex-col">
            <h3 class="text-main text-xl font-semibold mb-2">
              {post.data.title}
            </h3>
            <p class="text-tips mb-4">{post.data.description}</p>
            <a
              href={`/posts/${post.slug}`}
              class="text-link-interactive font-medium mt-auto"
            >
              Read more →
            </a>
          </article>
        ))}
      </div>
    )
  }
</section>
