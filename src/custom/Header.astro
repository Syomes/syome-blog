---
import "../custom/theme.css";
import siteConfig from "../custom/site-config";

const getMediaType = (path: string) => {
  if (!path) return null;
  const ext = path.toLowerCase().split(".").pop() as string;
  const imageExts = ["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"];
  const videoExts = ["mp4", "webm", "ogg", "mov", "avi", "mkv"];

  if (imageExts.includes(ext)) return "image";
  if (videoExts.includes(ext)) return "video";
  return null;
};

const actualBgType =
  siteConfig.headerBackground.type === "custom"
    ? getMediaType(siteConfig.headerBackground.mediaPath)
    : "default";
---

<header class="header-header relative overflow-hidden">
  {
    siteConfig.headerBackground.type === "custom" &&
    siteConfig.headerBackground.mediaPath ? (
      actualBgType === "image" ? (
        <div class="absolute inset-0 overflow-hidden">
          <img
            src={siteConfig.headerBackground.mediaPath}
            alt="Header Background"
            class="w-full h-full object-cover"
          />
          <div class="header-bg absolute inset-0" />
        </div>
      ) : actualBgType === "video" ? (
        <div class="absolute inset-0 overflow-hidden">
          <video
            class="w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
          >
            <source
              src={siteConfig.headerBackground.mediaPath}
              type={`video/${siteConfig.headerBackground.mediaPath.split(".").pop()}`}
            />
            Your browser does not support the video tag.
          </video>
          <div class="header-bg absolute inset-0" />
        </div>
      ) : null
    ) : (
      <>
        <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-600 opacity-100" />
        <div class="absolute inset-0 opacity-20">
          <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-white rounded-full mix-blend-multiply filter blur-xl animate-blob" />
          <div class="absolute top-1/3 right-1/4 w-64 h-64 bg-yellow-300 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000" />
          <div class="absolute bottom-1/4 left-1/2 w-64 h-64 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-4000" />
        </div>
      </>
    )
  }

  <div class="relative max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1
        class="text-4xl md:text-5xl font-extrabold tracking-tight leading-snug"
      >
        <span class="block">Welcome to</span>
        <span
          class="header-site-name block mt-2 bg-clip-text text-transparent leading-snug"
        >
          {siteConfig.siteName}
        </span>
      </h1>
      <p
        class="mt-4 max-w-lg mx-auto text-xl opacity-90"
        style="white-space: pre-line;"
      >
        {siteConfig.siteDescription}
      </p>
    </div>
  </div>
</header>

<style scoped>
  .header-header {
    @apply text-white;
  }

  .header-bg {
    @apply bg-black bg-opacity-30;
  }

  .header-site-name {
    @apply bg-gradient-to-r from-yellow-300 to-pink-300;
  }

  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }

    33% {
      transform: translate(30px, -50px) scale(1.1);
    }

    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }

    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }

  .animate-blob {
    animation: blob 10s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
