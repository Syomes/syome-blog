---
import "../styles/page.css";
import "../custom/theme.css";
import Footer from "../components/Footer.astro";
import siteConfig from "../custom/site-config";
import Loading from "../custom/Loading.astro";
const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full" style="scroll-padding-top: 4.5rem;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
  </head><div class="fixed inset-0 z-[-1]"></div>

  <title>{title}</title>
  <meta name="description" content={description} />

  <body class="h-full">
    <Loading />

    <iframe
      src="/background"
      class="fixed inset-0 z-[-1] w-full h-full border-none pointer-events-none"
      title="background"></iframe>

    <div class="min-h-screen flex flex-col">
      <header class="navbar-container site-header sticky top-0 z-30">
        <div
          class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between"
        >
          <a href="/" class="navbar-home text-xl font-bold"
            >{siteConfig.siteName}</a
          >
          <a
            href="/posts"
            class="text-link-interactive text-sm font-medium flex items-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-1"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                clip-rule="evenodd"></path>
            </svg>
            Back to Posts
          </a>
        </div>
      </header>

      <main class="flex-1 relative z-10 page-content">
        <div
          id="content-container"
          class="max-w-4xl mx-auto px-4 py-8 relative"
        >
          <header class="mb-10 text-center">
            {
              pubDate && (
                <time class="post-pub-date inline-block px-3 py-1 text-sm font-medium mb-4">
                  {new Date(pubDate).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              )
            }
            <h1
              class="text-main text-4xl md:text-5xl font-bold mb-4 break-words"
              style="line-height: 1.3;"
            >
              {title}
            </h1>
            {
              description && (
                <p class="post-description text-xl max-w-2xl mx-auto">
                  {description}
                </p>
              )
            }
          </header>

          <article class="markdown-renderer-article prose prose-lg max-w-none">
            <slot />
          </article>
        </div>
      </main>

      <div
        id="wrapper"
        class="fixed z-50 pointer-events-none w-full bottom-0 left-1/2 -translate-x-1/2"
      >
        <div class="max-w-5xl mx-auto py-20 relative h-0"></div>
      </div>

      <Footer />
    </div>

    <script src="/src/scripts/shared-layout"></script>
  </body>

</html>
